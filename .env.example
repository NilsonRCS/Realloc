NODE_ENV="development"
PORT=3000

# "inmemory" needs no database; "prisma" requires DATABASE_URL
USER_REPOSITORY="prisma"
DATABASE_URL="postgresql://realloc:realloc@localhost:5432/realloc"

# At least 16 characters. Generate one with: openssl rand -hex 32
JWT_SECRET="change-me-to-a-long-random-secret"
JWT_EXPIRES_IN="1h"

# First admin, created with: npm run seed:admin (no public sign-up exists)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-please"
ADMIN_NAME="Admin"
