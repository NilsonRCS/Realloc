NODE_ENV="development"
PORT=3000

# "inmemory" needs no database; "prisma" requires DATABASE_URL
USER_REPOSITORY="prisma"
DATABASE_URL="postgresql://realloc:realloc@localhost:5432/realloc"

# At least 16 characters. Generate one with: openssl rand -hex 32
JWT_SECRET="change-me-to-a-long-random-secret"

# Short-lived access token + rotating refresh token (stored hashed in the database)
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7

# Public recruiter sign-up (POST /api/auth/register) is throttled per IP
REGISTER_RATE_LIMIT_MAX=5
REGISTER_RATE_LIMIT_WINDOW_MINUTES=60

# Browser origins allowed to call the API with cookies, comma-separated (the Next.js front)
CORS_ORIGINS="http://localhost:3000"

# First admin, created with: npm run seed:admin (no public sign-up exists)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-please"
ADMIN_NAME="Admin"
