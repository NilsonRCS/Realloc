generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  RECRUITER
  RELOCATED
}

enum Seniority {
  JUNIOR
  MID
  SENIOR
  SPECIALIST
}

enum RelocationStatus {
  ACTIVE
  INACTIVE
}

model User {
  id           String   @id
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  recruiterProfile RecruiterProfile?
  relocatedProfile RelocatedProfile?
  refreshTokens    RefreshToken[]

  @@map("users")
}

model RecruiterProfile {
  id        String   @id
  userId    String   @unique @map("user_id")
  team      String?
  position  String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  relocateds RelocatedProfile[]

  @@map("recruiter_profiles")
}

model RelocatedProfile {
  id                     String           @id
  userId                 String?          @unique @map("user_id")
  responsibleRecruiterId String           @map("responsible_recruiter_id")
  name                   String
  seniority              Seniority
  description            String?
  relocationStartDate    DateTime         @map("relocation_start_date") @db.Date
  relocationEndDate      DateTime?        @map("relocation_end_date") @db.Date
  status                 RelocationStatus @default(ACTIVE)
  createdAt              DateTime         @default(now()) @map("created_at")
  updatedAt              DateTime         @updatedAt @map("updated_at")

  user                 User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  responsibleRecruiter RecruiterProfile @relation(fields: [responsibleRecruiterId], references: [id], onDelete: Restrict)

  @@index([responsibleRecruiterId])
  @@index([status])
  @@map("relocated_profiles")
}

model RefreshToken {
  id        String    @id
  userId    String    @map("user_id")
  /// All tokens descended from one login share a family; reuse of a revoked token revokes the family.
  familyId  String    @map("family_id")
  /// SHA-256 of the opaque token. The raw token is never stored.
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}
