{
  "name": "realloc",
  "version": "1.0.0",
  "description": "Realocação inteligente",
  "main": "dist/main/server.js",
  "scripts": {
    "dev": "tsx watch src/main/server.ts",
    "build": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
    "start": "node dist/main/server.js",
    "seed:admin": "tsx src/main/seed-admin.ts",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "test:integration:prisma": "node --import tsx --test tests/user-prisma.integration.test.ts",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "docker:dev": "docker compose up -d",
    "docker:prod": "docker compose -f docker-compose.prod.yml up --build",
    "docker:down": "docker compose down"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.4.3",
    "@prisma/client": "^6.19.3",
    "fastify": "^5.10.0",
    "jsonwebtoken": "^9.0.3",
    "prisma": "^6.19.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.1.2",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.23.1",
    "typescript": "^5.9.2"
  }
}
