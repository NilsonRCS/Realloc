            "description": "Público. Cria o login (role RELOCATED), ativo na hora. Depois: Login (realocado), List available recruiters e Submit form. O perfil só existe depois que o formulário é respondido.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Rui Realocado\",\n  \"email\": \"{{relocatedEmail}}\",\n  \"password\": \"{{relocatedPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Login (admin)",
